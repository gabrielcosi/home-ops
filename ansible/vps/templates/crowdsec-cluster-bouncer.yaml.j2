mode: nftables
log_mode: stdout
log_level: info
update_frequency: 10s
api_url: http://127.0.0.1:18080/
api_key: {{ crowdsec_cluster_api_key }}
retry_initial_connect: true
origins:
  - crowdsec
  - cscli
disable_ipv6: false
deny_action: DROP
deny_log: false
supported_decisions_types:
  - ban
nftables:
  ipv4:
    enabled: true
    set-only: false
    table: crowdsec-cluster
    chain: crowdsec-chain
    priority: -10
  ipv6:
    enabled: true
    set-only: false
    table: crowdsec-cluster
    chain: crowdsec6-chain
    priority: -10
nftables_hooks:
  - input
  - forward
