---
customization:
  extraKernelArgs:
    - -selinux
    - audit=0
    - i915.enable_guc=2
    - module_blacklist=e1000e
    - selinux=0
    - talos.auditd.disabled=1
    - talos.config.early={{ config_early }}
  systemExtensions:
    officialExtensions:
      - siderolabs/drbd
      - siderolabs/i915
      - siderolabs/intel-ucode
      - siderolabs/kata-containers
      - siderolabs/mei
      - siderolabs/nfsrahead
