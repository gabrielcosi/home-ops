---
machine:
  type: controlplane
  # ca merges as a unit; crt must be repeated alongside key
  ca:
    crt: op://k8s/talos/MACHINE_CA_CRT
    key: op://k8s/talos/MACHINE_CA_KEY
  features:
    kubernetesTalosAPIAccess:
      enabled: true
      allowedRoles:
        - os:admin
      allowedKubernetesNamespaces:
        - system-upgrade
cluster:
  # ca merges as a unit; crt must be repeated alongside key
  ca:
    crt: op://k8s/talos/CLUSTER_CA_CRT
    key: op://k8s/talos/CLUSTER_CA_KEY
  allowSchedulingOnControlPlanes: true
  aggregatorCA:
    crt: op://k8s/talos/CLUSTER_AGGREGATORCA_CRT
    key: op://k8s/talos/CLUSTER_AGGREGATORCA_KEY
  serviceAccount:
    key: op://k8s/talos/CLUSTER_SERVICEACCOUNT_KEY
  apiServer:
    image: registry.k8s.io/kube-apiserver:v1.37.0
    certSANs:
      - k8s.internal
    extraArgs:
      enable-aggregator-routing: "true"
      feature-gates: HPAScaleToZero=true
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata
  controllerManager:
    image: registry.k8s.io/kube-controller-manager:v1.37.0
    extraArgs:
      bind-address: 0.0.0.0
      feature-gates: HPAScaleToZero=true
  coreDNS:
    disabled: true
  proxy:
    disabled: true
    image: registry.k8s.io/kube-proxy:v1.37.0
  scheduler:
    image: registry.k8s.io/kube-scheduler:v1.37.0
    config:
      apiVersion: kubescheduler.config.k8s.io/v1
      kind: KubeSchedulerConfiguration
      profiles:
        - schedulerName: default-scheduler
          plugins:
            score:
              disabled:
                - name: ImageLocality
          pluginConfig:
            - name: PodTopologySpread
              args:
                defaultingType: List
                defaultConstraints:
                  - maxSkew: 1
                    topologyKey: kubernetes.io/hostname
                    whenUnsatisfiable: ScheduleAnyway
    extraArgs:
      bind-address: 0.0.0.0
  etcd:
    advertisedSubnets:
      - 192.168.42.0/24
    ca:
      crt: op://k8s/talos/CLUSTER_ETCD_CA_CRT
      key: op://k8s/talos/CLUSTER_ETCD_CA_KEY
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
---
apiVersion: v1alpha1
kind: RawVolumeConfig
name: miroir
provisioning:
  diskSelector:
    match: disk.model == "BC511 NVMe SK hynix 256GB" && !system_disk
  minSize: 256GB
