{
	email {$CADDY_ACME_EMAIL}
	http_port 8080
	https_port 8443

	# L4: split incoming TLS by SNI.
	layer4 {
		:443 {
			matching_timeout 15s

			# Hostnames this VPS serves itself → terminate locally.
			@local tls sni {$VPS_LOCAL_HOSTS}
			route @local {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8443
				}
			}

			# Everything else → pass through, still encrypted, to the towonel tunnel → home.
			@tls tls
			route @tls {
				proxy {
					proxy_protocol v2
					upstream towonel-hub:4443
				}
			}
		}
		:80 {
			@local_http http host {$VPS_LOCAL_HOSTS}
			route @local_http {
				proxy {
					proxy_protocol v2
					upstream 127.0.0.1:8080
				}
			}
		}
	}

	# Internal L7 listeners fed by the L4 routes above (PROXY protocol from localhost only).
	servers :8443 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
			tls
		}
	}
	servers :8080 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow 127.0.0.1/32
			}
		}
	}

	log default {
		output stdout
		format json
	}
}

# --- VPS-local sites (each must also be listed in VPS_LOCAL_HOSTS) ---

towonel.xcd.dev {
	log
	reverse_proxy towonel-hub:8443
}

doco-cd.xcd.dev {
	log
	reverse_proxy doco-cd:80
}

status-vps.xcd.dev {
	log
	reverse_proxy gatus:8080
}
